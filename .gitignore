# Gastro3D - Git Ignore Configuration

# Environment files
.env
.env.backup
.env.production
.env.local
.env.*.local

# Laravel Backend
/backend/vendor/
/backend/node_modules/
/backend/public/hot
/backend/public/storage
/backend/storage/*.key
/backend/storage/framework/cache/*
!/backend/storage/framework/cache/.gitignore
/backend/storage/framework/sessions/*
!/backend/storage/framework/sessions/.gitignore
/backend/storage/framework/testing/*
!/backend/storage/framework/testing/.gitignore
/backend/storage/framework/views/*
!/backend/storage/framework/views/.gitignore
/backend/storage/logs/*
!/backend/storage/logs/.gitignore
/backend/storage/app/public/models/*
!/backend/storage/app/public/models/.gitignore
/backend/storage/app/public/uploads/*
!/backend/storage/app/public/uploads/.gitignore
/backend/.phpunit.result.cache

# Next.js Frontend
/frontend/node_modules/
/frontend/.next/
/frontend/out/
/frontend/build/
/frontend/coverage/
/frontend/*.tsbuildinfo
/frontend/next-env.d.ts.bak

# Docker and local storage
docker/postgres/data/
docker-compose.override.yml
backups/
*.sql

# Logs and debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.patch
*.diff
